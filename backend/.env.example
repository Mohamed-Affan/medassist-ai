# Copy this file to .env for local development. Do not commit the resulting .env file.
# Generate a long, random value for SECRET_KEY before deploying.
SECRET_KEY=replace-with-a-long-random-secret

# SQLite is the default local database. Use a managed database URL for production.
DATABASE_URL=sqlite:///./medassist_ai.db

# Add only the browser origins that should call this API.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
